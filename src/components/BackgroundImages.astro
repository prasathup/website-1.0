---
// Responsive background image component using pure CSS and High-Performance CSS Masks
// Images used:
// - Left: 709×1117px
// - Right: 689×1073px
// - Bottom: 363×315px (Enterprise)
import { Image } from 'astro:assets';
import leftBg from '../assets/Landing Background/macbook-pro-16-left-screen.png';
import rightBg from '../assets/Landing Background/macbook-pro-16-right-screen.png';
import bottomBg from '../assets/Landing Background/macbook-pro-16-mid-bottom-screen.png';

// Shown on home and bio pages as specified in Layout.astro
const { pageName } = Astro.props;
const shouldShowByDefault = pageName === 'home' || pageName === 'bio';
---

<div class={`background-container ${shouldShowByDefault ? 'visible' : ''}`} data-page-name={pageName || 'unknown'}>
  <!-- Simple solid background color (Unmasked) -->
  <div class="base-color"></div>
  
  <!-- MASK LAYER: Controls visibility of all artwork -->
  <!-- Initially hidden (via mask), revealed by cursor interaction -->
  <div id="artwork-mask-layer">
      <!-- Left image - AVIF with high quality -->
      <div class="art-container left-art">
        <Image 
          src={leftBg} 
          alt="" 
          class="bg-image left-bg-image" 
          loading="eager"
          quality="high"
          format="avif"
        />
      </div>
      
      <!-- Right image - AVIF with high quality -->
      <div class="art-container right-art">
        <Image 
          src={rightBg} 
          alt="" 
          class="bg-image right-bg-image" 
          loading="eager"
          quality="high"
          format="avif"
        />
      </div>
      
      <!-- Bottom image (Enterprise) - AVIF with high quality -->
      <div class="art-container bottom-art" id="enterprise-container">
        <Image 
          src={bottomBg} 
          alt="" 
          class="bg-image bottom-bg-image" 
          loading="eager"
          id="enterprise-image"
          quality="high"
          format="avif"
        />
      </div>
  </div>
</div>

<script is:inline define:vars={{ shouldShowByDefault }}>
  // --- Physics-Based "Microscope" Interaction Logic ---
  
  const state = {
    // Reveal State (Click to Toggle)
    isExpanded: false, // false = Spotlight, true = Full Reveal via Mask

    // Focus State (Controlled by Scroll)
    focusLevel: 0, // 0 = Blurry, 1 = Sharp
    targetFocus: 0,
    
    // Velocity State (Motion Blur)
    mouseX: 0,
    mouseY: 0,
    lastMouseX: 0,
    lastMouseY: 0,
    velocity: 0,
    
    // Click tracking for triple-click reveal
    clickCount: 0, // Track number of clicks in sequence
    lastClickTime: 0, // Timestamp of last click
    clickResetTimeout: null, // Timeout to reset click counter
    
    // Config
    maxBlur: 20, // px
    scrollSensitivity: 0.001,
    velocitySensitivity: 0.15,
    maxVelocityBlur: 10,
    hoverSoftness: 135,
    expandRadius: '200vmax', // Full reveal size
    tripleClickWindow: 500, // Time window in ms for triple click detection
    
    // Perf
    lastTime: performance.now()
  };

  function updateMaskVariables(x, y, radius, softness, customTransition = null) {
    const maskLayer = document.getElementById('artwork-mask-layer');
    if (!maskLayer) return;

    if (x !== null) maskLayer.style.setProperty('--mask-x', `${x}px`);
    if (y !== null) maskLayer.style.setProperty('--mask-y', `${y}px`);
    if (radius !== null) maskLayer.style.setProperty('--mask-radius', typeof radius === 'number' ? `${radius}px` : radius);
    if (softness !== null) maskLayer.style.setProperty('--mask-softness', `${softness}px`);
    
    if (customTransition) {
        maskLayer.style.transition = customTransition;
    } else {
        maskLayer.style.removeProperty('transition');
    }
  }

  // Helper: Detect if cursor is in an "Art Zone"
  function isInArtZone(x, y) {
    const width = window.innerWidth;
    const height = window.innerHeight;
    
    // Zones: Left (25%), Right (25%), Bottom (20%)
    const isLeftZone = x < (width * 0.25);
    const isRightZone = x > (width * 0.75);
    const isBottomZone = y > (height * 0.80);
    
    return isLeftZone || isRightZone || isBottomZone;
  }

  // --- 1. Focus Knob (Local Scroll) ---
  // Intercepts scroll wheel ONLY on Art Zones (Sides & Bottom).
  // Center of viewport always scrolls the page. Do NOT blanket-skip home/bio —
  // that killed artwork focus reveal. Page-scroll stalls were from body
  // scrollport + lens RAF thrash (fixed separately), not from zone hijack.
  function handleWheel(e) {
    // Narrow phones: no art-zone hijack (artwork hidden / touch scroll).
    // iPad / desktop (≥768) keep zone focus so side/bottom wheel reveals art.
    if (window.innerWidth < 768) return;

    // Prefer last mousemove coords; some wheel events report 0,0 → false left zone.
    const x = e.clientX || state.mouseX;
    const y = e.clientY || state.mouseY;
    if (isInArtZone(x, y)) {
        e.preventDefault(); // Stop page scroll — this wheel gesture focuses art
        e.stopPropagation();
        e.stopImmediatePropagation();

        // Scroll Down (positive delta) -> FOCUS (Increase target toward 1)
        // Scroll Up (negative delta) -> BLUR (Decrease target toward 0)
        state.targetFocus += e.deltaY * state.scrollSensitivity;
        state.targetFocus = Math.max(0, Math.min(1, state.targetFocus));
    }
  }

  // --- 2. Velocity & Mask Tracking ---
  function handleMouseMove(e) {
    state.mouseX = e.clientX;
    state.mouseY = e.clientY;

    // Only update mask position if NOT expanded (Spotlight Mode)
    // If expanded, the mask covers everything anyway, but we keep the spotlight center following mouse for effect
    updateMaskVariables(state.mouseX, state.mouseY, null, null);
  }

  // --- 3. Click to Reveal (Independent of Focus) ---
  function handleClick(e) {
    const backgroundContainer = document.querySelector('.background-container');
    if (!backgroundContainer || !backgroundContainer.classList.contains('visible')) return;

    // Only allow toggle if clicking ON the artwork
    if (!isInArtZone(e.clientX, e.clientY)) return;

    const currentTime = Date.now();

    if (state.isExpanded) {
        // COLLAPSE (Spotlight Mode) - Single click to collapse
        state.isExpanded = false;
        // Reset click tracking when collapsing
        state.clickCount = 0;
        state.lastClickTime = 0;
        if (state.clickResetTimeout) {
            clearTimeout(state.clickResetTimeout);
            state.clickResetTimeout = null;
        }
        updateMaskVariables(
            null, null, 
            0, // Back to 0 radius (Spotlight only)
            null, 
            '--mask-radius 3.0s cubic-bezier(0.2, 0.8, 0.2, 1)' // Slow collapse (3.0s)
        );
    } else {
        // EXPAND (Full Reveal) - Requires triple click
        // Check if clicks are within the time window
        if (currentTime - state.lastClickTime > state.tripleClickWindow) {
            // Too much time passed, reset counter
            state.clickCount = 0;
        }
        
        state.clickCount++;
        state.lastClickTime = currentTime;
        
        // Clear existing timeout
        if (state.clickResetTimeout) {
            clearTimeout(state.clickResetTimeout);
        }
        
        // Set timeout to reset click counter if no more clicks
        state.clickResetTimeout = setTimeout(() => {
            state.clickCount = 0;
            state.clickResetTimeout = null;
        }, state.tripleClickWindow);
        
        // Check if we have 3 clicks
        if (state.clickCount >= 3) {
            // EXPAND (Full Reveal)
            state.isExpanded = true;
            state.clickCount = 0; // Reset after successful reveal
            if (state.clickResetTimeout) {
                clearTimeout(state.clickResetTimeout);
                state.clickResetTimeout = null;
            }
            updateMaskVariables(
                null, null, 
                state.expandRadius, 
                null, 
                '--mask-radius 6.0s cubic-bezier(0.2, 0.8, 0.2, 1)' // Drastic Slowdown (6.0s)
            );
        }
    }
  }

  // --- 4. Physics Loop (RAF) ---
  function updatePhysics(time) {
    const dt = time - state.lastTime;
    state.lastTime = time;

    // 1. Smooth Focus Integration
    // Lerp current focus towards target focus
    const focusLerpFactor = 0.1;
    state.focusLevel += (state.targetFocus - state.focusLevel) * focusLerpFactor;
    
    // Calculate static focus blur (Inverse of focus level)
    // Level 0 = Max Blur (20px), Level 1 = No Blur (0px)
    const focusBlur = state.maxBlur * (1 - state.focusLevel);

    // 2. Velocity Calculation
    const dx = state.mouseX - state.lastMouseX;
    const dy = state.mouseY - state.lastMouseY;
    const dist = Math.sqrt(dx * dx + dy * dy);
    
    // Simple velocity: pixels per frame (approx)
    // Add "decay" to velocity for smoothness
    state.velocity = state.velocity * 0.8 + dist * 0.2; 
    
    // Calculate motion blur
    // Disable motion blur if fully expanded (per user request)
    let motionBlur = 0;
    if (!state.isExpanded) {
        motionBlur = Math.min(state.maxVelocityBlur, state.velocity * state.velocitySensitivity);
    }
    
    // 3. Combine & Apply
    const totalBlur = focusBlur + motionBlur;
    
    // Update CSS Variable
    // Optimization: Only update if changed significantly
    const container = document.querySelector('.background-container');
    if (container && container.classList.contains('visible')) {
       container.style.setProperty('--dynamic-blur', `${totalBlur.toFixed(1)}px`);
    }

    // Update history
    state.lastMouseX = state.mouseX;
    state.lastMouseY = state.mouseY;

    requestAnimationFrame(updatePhysics);
  }

  // --- Integrations ---

  function setupEnterpriseResponsiveness() {
    const enterpriseImg = document.getElementById('enterprise-image');
    const enterpriseContainer = document.getElementById('enterprise-container');
    if (!enterpriseImg || !enterpriseContainer) return;
    if (window.getComputedStyle(enterpriseContainer).display === 'none') return;
    enterpriseImg.style.opacity = '1';
  }
  
  function checkVisibility() {
    const backgroundContainer = document.querySelector('.background-container');
    if (!backgroundContainer) return;

    const body = document.body;
    const pageName = body.getAttribute('data-page') || backgroundContainer.getAttribute('data-page-name');
    const isDisplayPage = pageName === 'home' || pageName === 'bio';
    
    if (isDisplayPage) {
        if (!document.documentElement.classList.contains('transitioning')) {
            backgroundContainer.classList.add('visible');
            const baseColor = backgroundContainer.querySelector('.base-color');
            if (baseColor) {
                baseColor.setAttribute('data-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
            }
        }
        setupEnterpriseResponsiveness();
    } else {
        backgroundContainer.classList.remove('visible');
    }
  }

  function initialize() {
    window.addEventListener('mousemove', handleMouseMove);
    window.addEventListener('click', handleClick);
    
    // Add non-passive listener for scroll interception to DOCUMENT (capturing phase for priority)
    // Using { passive: false, capture: true } to ensure we intercept before anything else
    document.addEventListener('wheel', handleWheel, { passive: false, capture: true });
    
    // Start Physics Loop
    requestAnimationFrame(updatePhysics);

    setTimeout(() => {
      if (shouldShowByDefault) {
        const bg = document.querySelector('.background-container');
        if (bg) {
            bg.classList.add('visible');
            setupEnterpriseResponsiveness();
        }
      }
      setTimeout(checkVisibility, 50);
    }, 10);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }
  
  // Cleanup to prevent duplicate listeners on HMR/Navigation
  document.addEventListener('astro:before-swap', () => {
    window.removeEventListener('mousemove', handleMouseMove);
    window.removeEventListener('click', handleClick);
    document.removeEventListener('wheel', handleWheel, { capture: true });
    // Clear click tracking timeout on cleanup
    if (state.clickResetTimeout) {
      clearTimeout(state.clickResetTimeout);
      state.clickResetTimeout = null;
    }
    state.clickCount = 0;
    state.lastClickTime = 0;
  });

  document.addEventListener('astro:page-load', () => {
    checkVisibility();
  });
  
  document.addEventListener('astro:before-preparation', () => {
    document.documentElement.classList.add('transitioning');
    const bg = document.querySelector('.background-container');
    if (bg) bg.classList.add('no-transition');
  });
  
  document.addEventListener('astro:after-preparation', () => {
    document.documentElement.classList.remove('transitioning');
    const bg = document.querySelector('.background-container');
    if (bg) bg.classList.remove('no-transition');
  });

</script>

<style>
  :root {
    /* Existing Config */
    --left-art-width-xl: 45%;
    --right-art-width-xl: 45%;
    --left-art-max-width: 709px;
    --right-art-max-width: 689px;
    --bottom-art-width: 12%; 
    --bottom-art-max-width: 173px;
    --art-opacity: 1;
    --art-min-height: 100vh;
    --art-bottom-position: 0;

    /* Mask Animation Config */
    --mask-x: 50%;
    --mask-y: 50%;
    --mask-radius: 0px; 
    --mask-softness: 135px;
    
    /* Physics Blur */
    --dynamic-blur: 20px; /* Init as blurry */
  }
  
  @property --mask-radius {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }
  
  @property --mask-softness {
    syntax: '<length>';
    inherits: true;
    initial-value: 135px;
  }

  .background-container {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: var(--z-background, -1);
    isolation: isolate;
    opacity: 0;
    transition: opacity 0.5s ease;
    
    /* Pass the physics blur to children */
    --current-blur: var(--dynamic-blur);
  }
  
  .background-container.visible {
    opacity: 1;
  }
  
  .base-color {
    position: absolute;
    inset: 0;
    background-color: var(--current-bg-light);
    transition: background-color var(--transition-duration, 0.5s) ease, 
                background-image var(--transition-duration, 0.5s) ease;
    z-index: 1;
  }
  
  :global(html.dark) .base-color {
    background-color: var(--current-bg-dark);
    background-image: var(--current-bg-dark-gradient);
  }

  /* --- MASK WRAPPER --- */
  #artwork-mask-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    
    /* Soft Spotlight Mask */
    mask-image: radial-gradient(
        circle at var(--mask-x) var(--mask-y), 
        black var(--mask-radius), /* Focus Center or Full Reveal */
        transparent calc(var(--mask-radius) + var(--mask-softness)) /* Fade Edge */
    );
    -webkit-mask-image: radial-gradient(
        circle at var(--mask-x) var(--mask-y), 
        black var(--mask-radius), 
        transparent calc(var(--mask-radius) + var(--mask-softness))
    );
    
    will-change: mask-image;
  }

  /* Art Containers (Children of Mask Layer) */
  .art-container {
    position: fixed;
    overflow: visible;
    transition: width 0.5s ease, height 0.5s ease, opacity 0.5s ease;
  }
  
  /* Apply Dynamic Blur to Images */
  .bg-image {
    display: block;
    width: 100%;
    height: 100%;
    opacity: var(--art-opacity);
    object-position: bottom;
    object-fit: contain;
    max-height: none;
    transform-origin: bottom center;
    
    /* PHYSICS BLUR FILTER */
    filter: blur(var(--current-blur)); 
    will-change: filter;
    /* Hint for GPU acceleration */
    transform: translateZ(0); 
  }
  
  /* Layout Constraints (Same as before) */
  .left-art {
    bottom: var(--art-bottom-position);
    left: 0;
    width: var(--left-art-width-xl);
    height: var(--art-min-height);
    max-width: var(--left-art-max-width);
    display: flex;
    align-items: flex-end;
  }
  .left-bg-image { object-position: left bottom; }
  
  .right-art {
    bottom: var(--art-bottom-position);
    right: 0;
    width: var(--right-art-width-xl);
    height: var(--art-min-height);
    max-width: var(--right-art-max-width);
    display: flex;
    align-items: flex-end;
  }
  .right-bg-image { object-position: right bottom; }
  
  .bottom-art {
    bottom: -2rem;
    left: 50%;
    transform: translateX(-50%);
    width: var(--bottom-art-width);
    height: auto;
    max-width: var(--bottom-art-max-width);
    aspect-ratio: 363/315;
    z-index: 4; 
    transition: opacity 0.4s ease;
  }
  /* Fix: Combine blur with brightness so one doesn't overwrite the other */
  .bottom-bg-image { 
    object-position: center bottom; 
    filter: blur(var(--current-blur)) brightness(1.2); 
  }

  /* Dark Mode & Responsiveness Preserved */
  :global(html.dark) .base-color {
    background-color: var(--current-bg-dark) !important;
    background-image: var(--current-bg-dark-gradient) !important;
  }
  /* Fix: Combine blur with brightness for dark mode too */
  :global(html.dark) .bottom-bg-image { 
    filter: blur(var(--current-blur)) brightness(1.5); 
  }

  /* Breakpoints */
  @media (min-width: 1800px) {
    :root { --left-art-width-xl: 50%; --right-art-width-xl: 50%; }
  }
  @media (max-width: 1800px) {
    :root { --left-art-width-xl: 45%; --right-art-width-xl: 45%; --bottom-art-width: 10.5%; }
  }
  @media (max-width: 1400px) {
    :root { --left-art-width-xl: 38%; --right-art-width-xl: 38%; --bottom-art-width: 9.5%; }
  }
  @media (max-width: 1200px) {
    :root { --left-art-width-xl: 32%; --right-art-width-xl: 32%; --bottom-art-width: 8.6%; }
  }
  @media (max-width: 1024px) {
    :root { --left-art-width-xl: 25%; --right-art-width-xl: 25%; --bottom-art-width: 7.1%; }
    .left-art, .right-art, .bottom-art { display: none; }
  }
  @media (max-height: 600px) {
    .left-art, .right-art { height: 600px; }
  }
  @media (min-height: 900px) {
    body:has(.content-container:nth-child(3)) .bottom-art {}
  }
  .dark-theme {
    background-color: var(--current-bg-dark) !important;
    background-image: var(--current-bg-dark-gradient) !important;
  }
  .background-container.no-transition,
  .background-container.no-transition * {
    transition: none !important;
    animation-delay: 0s !important;
    animation-duration: 0s !important;
  }
</style> 
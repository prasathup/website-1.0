---
/**
 * MemorySpheresLayout — floating memory spheres (perspective cloud).
 * Client boot lives solely in memorySpheresClient.ts (no duplicated inline script).
 */
import type { CollectionEntry } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';
import CraftLayout from '../craft/CraftLayout.astro';
import { buildMemoryMedia } from '../../lib/memories/media';

export interface Props {
  entry: CollectionEntry<'journey'>;
}

const { entry } = Astro.props;
const { title, description } = entry.data;
const baseMediaItems = buildMemoryMedia(entry);
const baseUrl =
	(Astro.site as URL | undefined) ??
	(Astro.url as URL | undefined) ??
	new URL('/', 'http://localhost');

const resolveMediaPath = (value?: string) => {
	if (!value) return value;
	try {
		return new URL(value, baseUrl).pathname;
	} catch {
		return value;
	}
};

const sphereColorNames = ['sphere-pink', 'sphere-orange', 'sphere-cyan', 'sphere-purple', 'sphere-green'];
const hueRotations = [330, 25, 180, 270, 120];

const normalizedMediaItems = baseMediaItems.map((item, index) => {
	const colorIndex = index % sphereColorNames.length;
	return {
		...item,
		src: resolveMediaPath(item.src),
		poster: resolveMediaPath(item.poster),
		thumb: resolveMediaPath(item.thumb),
		mid: resolveMediaPath(item.mid),
		focus: resolveMediaPath(item.focus),
		colorClass: sphereColorNames[colorIndex],
		hue: hueRotations[colorIndex]
	};
});

const spherePositions = normalizedMediaItems.map((_, index) => {
  const colorIndex = index % sphereColorNames.length;
  return {
    startX: Math.random() * 70 + 15,
    startY: Math.random() * 70 + 15,
    size: 140 + Math.random() * 80,
    zIndex: index + 1,
    colorClass: sphereColorNames[colorIndex],
    hue: hueRotations[colorIndex]
  };
});

/** Optional theme landscape — only wire paths that exist in public/. */
const publicMemories = join(fileURLToPath(new URL('../../../public/media/Memories', import.meta.url)));
const landscapeConfig: { poster?: string; src?: string } = {};
if (existsSync(join(publicMemories, 'landscape-poster.jpg'))) {
	const poster = resolveMediaPath('/media/Memories/landscape-poster.jpg');
	if (poster) landscapeConfig.poster = poster;
}
if (existsSync(join(publicMemories, 'landscape-theme.mp4'))) {
	const src = resolveMediaPath('/media/Memories/landscape-theme.mp4');
	if (src) landscapeConfig.src = src;
}

const safeMediaJSON = JSON.stringify(normalizedMediaItems).replace(/</g, '\\u003c');
const safePaletteJSON = JSON.stringify(spherePositions).replace(/</g, '\\u003c');
const safeLandscapeJSON = JSON.stringify(landscapeConfig).replace(/</g, '\\u003c');
const glassField = resolveMediaPath('/media/JN-000-OrbMedia_field.webp');
const glassFocus = resolveMediaPath('/media/JN-000-OrbMedia_focus.webp');
---

<CraftLayout title={`${title} - Personal Website`} pageName="journey">
  <div
    class="memory-spheres-page"
    data-media={safeMediaJSON}
    data-positions={safePaletteJSON}
    data-landscape={safeLandscapeJSON}
    data-glass-field={glassField}
    data-glass-focus={glassFocus}
  >
    <div class="orbs-header-overlay">
      <h1 class="craft-title">{title}</h1>
      <p class="craft-subtitle" set:html={description}></p>
    </div>

    <div class="bubbles-root" data-orbs-root></div>
  </div>
</CraftLayout>

<script>
  import '../../scripts/memorySpheresClient';
</script>

<style is:global>
  :global(html:has(.memory-spheres-page)),
  :global(body:has(.memory-spheres-page)) {
    overflow: hidden !important;
    height: 100dvh !important;
    width: 100vw !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    inset: 0 !important;
    overscroll-behavior: none !important;
    touch-action: none !important;
  }

  body.page-journey .memory-spheres-page ~ .craft-header,
  .memory-spheres-page ~ .craft-header {
    display: none;
  }

  body.page-journey:has(.memory-spheres-page) .craft-header {
    display: none;
  }

  body.page-journey:has(.memory-spheres-page) .section-top-spacer {
    display: none;
  }

  .memory-spheres-page {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    touch-action: none;
    overscroll-behavior: none;
    z-index: 10;
  }

  .memory-spheres-page .orbs-header-overlay {
    position: fixed;
    top: clamp(80px, 12vh, 120px);
    left: 0;
    right: 0;
    z-index: 10000;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 clamp(16px, 3vw, 28px);
    opacity: 0.8;
    background: transparent;
  }

  .memory-spheres-page .orbs-header-overlay .craft-title,
  .memory-spheres-page .orbs-header-overlay .craft-subtitle {
    pointer-events: auto;
  }

  .memory-spheres-page .orbs-header-overlay .craft-title {
    font-size: clamp(2rem, 4.8vw, 3rem);
    line-height: 1.1;
    margin: 4px 0 8px 0;
    text-shadow: none;
    -webkit-font-smoothing: antialiased;
    display: none;
  }

  .memory-spheres-page .orbs-header-overlay .craft-subtitle {
    max-width: 1100px;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.5;
    opacity: 0.95;
  }

  .memory-spheres-page.has-centered-sphere .orbs-header-overlay {
    opacity: 0.3;
    transition: opacity 0.7s cubic-bezier(0.45, 0, 0.55, 1);
  }

  .memory-spheres-page .memory-landscape-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: transparent;
  }

  .memory-spheres-page .memory-landscape-poster,
  .memory-spheres-page .memory-landscape-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .memory-spheres-page .memory-landscape-poster:not([src]),
  .memory-spheres-page .memory-landscape-video:not([src]) {
    display: none;
    border: 0;
  }

  .memory-spheres-page .memory-landscape-video {
    opacity: 0;
  }

  .memory-spheres-page .memory-landscape-video[src] {
    opacity: 0.55;
  }

  .memory-spheres-page .bubbles-root {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    touch-action: none;
    overscroll-behavior: none;
    z-index: 1;
  }

  .memory-spheres-page .bubbles-root canvas {
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
  }
</style>

		color: #a5a7a278;
	}

	/* Keyframes deleted as morphing is now WebGL based */

    /* Narrow viewports: oval taper (1–4) + soft fill (5–6). Bubble geometry frozen. */
    @media (max-width: 900px) {
        .wave-bubble-container {
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: calc(100vw - 12px);
            height: calc(100dvh - 100px);
            padding: 0.5rem;
            touch-action: pan-y;
            container-type: size;
            container-name: bubble;
        }

        .bio-content {
            transform: none;
            gap: 0.5rem;
        }

        /*
          Oval craft is mobile-UA only. Narrow desktop (body.is-desktop ≤900px)
          keeps the deployed/main look: no shape-outside, 2rem title, 1.25rem body.
        */
        body.is-mobile #section-1 .bio-content,
        body.is-mobile #section-2 .bio-content,
        body.is-mobile #section-3 .bio-content,
        body.is-mobile #section-4 .bio-content,
        body.is-mobile #section-6 .bio-content {
            /* Anchor for absolutely centered oval-flow (endosome box, not flex quirks) */
            display: block !important;
            position: relative;
            width: 100%;
            height: 100%;
            gap: 0;
            transform: none !important;
            margin: 0;
            padding: 0;
        }

        body.is-mobile .oval-flow {
            /*
              Content-sized oval centered on the bubble. Mobile sketch tracks
              the same bubble via content_pos, so this is the charcoal center.
              Carve height must match in-flow copy — oversized floats loft text.
            */
            --oval-flow-w: 86%;
            --oval-pole: 1.1em;
            --oval-nudge-y: 0px;
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, calc(-50% + var(--oval-nudge-y)));
            width: var(--oval-flow-w);
            height: auto;
            max-width: 100%;
            max-height: 82%;
            text-align: center;
            display: block;
        }

        body.is-mobile .oval-carve {
            display: block;
            height: var(--oval-carve-h, 22em);
            width: 50%;
        }

        /*
          Full ellipse (x = 1 - sqrt(1-(2t-1)^2)) with pole floor at 70% of the
          half-float so tip chords stay ~30% of flow width — oval silhouette
          without zero-width clearout at the bottom.
        */
        body.is-mobile .carve-left {
            float: left;
            shape-outside: polygon(0% 0%, 70% 0%, 51.6% 6.25%, 33.9% 12.5%, 21.9% 18.75%, 13.4% 25%, 7.3% 31.25%, 3.2% 37.5%, 0.8% 43.75%, 0% 50%, 0.8% 56.25%, 3.2% 62.5%, 7.3% 68.75%, 13.4% 75%, 21.9% 81.25%, 33.9% 87.5%, 51.6% 93.75%, 70% 100%, 0% 100%);
            shape-margin: clamp(3px, 1.4cqmin, 10px);
        }

        body.is-mobile .carve-right {
            float: right;
            shape-outside: polygon(100% 0%, 30% 0%, 48.4% 6.25%, 66.1% 12.5%, 78.1% 18.75%, 86.6% 25%, 92.7% 31.25%, 96.8% 37.5%, 99.2% 43.75%, 100% 50%, 99.2% 56.25%, 96.8% 62.5%, 92.7% 68.75%, 86.6% 75%, 78.1% 81.25%, 66.1% 87.5%, 48.4% 93.75%, 30% 100%, 100% 100%);
            shape-margin: clamp(3px, 1.4cqmin, 10px);
        }

        body.is-mobile .oval-spacer {
            display: block;
            height: var(--oval-pole);
            width: 100%;
        }

        @supports not (height: 1cqmin) {
            body.is-mobile .carve-left,
            body.is-mobile .carve-right {
                shape-margin: 6px;
            }
        }

        body.is-mobile .oval-flow .name-title {
            font-size: clamp(1.85rem, 6.8vw, 2.2rem) !important;
        }

        body.is-mobile .oval-flow .bio-paragraph {
            font-size: clamp(1.28rem, 4.8vw, 1.48rem) !important;
            line-height: 1.38 !important;
            max-width: none !important;
            /* Match Becoming (.text-content gap) — breathing room under title */
            margin: var(--spacing-sm) 0 0 !important;
            padding: 0 !important;
            text-align: center !important;
        }

        body.is-mobile .oval-flow .social-links {
            margin-top: 0.75rem;
            clear: both;
        }

        /* Narrow desktop: deployed/main bubble + type (oval unwrap is global above) */
        body.is-desktop .wave-bubble-container {
             width: min(90vw, 600px);
             height: min(85vh, 800px);
             padding: 2rem;
        }

        body.is-desktop .name-title {
            font-size: 2rem;
        }

        body.is-desktop .content-section .bio-paragraph {
            font-size: 1.25rem !important;
            line-height: 1.6;
            max-width: 78% !important;
            text-align: center !important;
        }

        /* Soft fill: Becoming only (portrait + short copy) */
        #section-5 .bio-content {
            gap: 0.75rem !important;
            padding: 0.5rem !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            width: 100% !important;
            height: 100%;
        }

        #section-5 .profile-image-container {
            margin-bottom: 0.5rem !important;
        }

        #section-5 .profile-image {
            width: 120px !important;
            height: auto !important;
        }

        body.is-desktop #section-5 .profile-image {
             width: 140px !important;
        }

        body.is-desktop #section-5 .bio-content {
             gap: 0.5rem !important;
        }

        #section-5 .text-content {
            margin-top: 0 !important;
            text-align: center !important;
            width: 100% !important;
        }

        body.is-mobile #section-5 .name-title {

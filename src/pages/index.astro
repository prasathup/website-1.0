---
import Layout from '../layouts/Layout.astro';
import EndosomeBackground from '../components/EndosomeBackground.astro';
import EndosomeSketch from '../components/EndosomeSketchWebGPU.astro';
import { Image } from 'astro:assets';
import profilePic from '../assets/Profile_pic.jpg';
---

<Layout title="Personal Website" pageName="home">
	<!-- The .main-content class in Layout.astro now handles the safe area -->
    <div class="content-wrapper" tabindex="0">
        <!-- Scroll Proxy for CSS Snap and Layout -->
        <div class="scroll-proxy">
            <div class="snap-section" data-index="1"></div>
            <div class="snap-section" data-index="2"></div>
            <div class="snap-section" data-index="3"></div>
            <div class="snap-section" data-index="4"></div>
            <div class="snap-section" data-index="5"></div>
            <div class="snap-section" data-index="6"></div>
        </div>

		<!-- Background Endosomes (Outside the wobble container) -->
		<EndosomeBackground />
		
        <!-- MAIN ENDOSOME SKETCH: Placed at root to ensure full-screen fixed positioning works correctly -->
		<EndosomeSketch />

		<div class="wave-bubble-container" data-active="1">
            <div id="section-1" class="content-section">
				<div class="bio-content flex flex-col items-center w-full">
					<div class="oval-flow">
						<div class="oval-carve carve-left" aria-hidden="true"></div>
						<div class="oval-carve carve-right" aria-hidden="true"></div>
						<div class="oval-spacer oval-spacer-top" aria-hidden="true"></div>
						<div class="name-container">
							<div class="title-wrapper">
								<div class="hi-svg-container">
									<img src="/HeartStopperSVG/Hi.svg" alt="" class="hi-svg" />
								</div>
								<h1 class="name-title">
									<span class="animated-gradient">I am Your Name</span>
								</h1>
								<div class="title-underline"></div>
							</div>
						</div>
						<p class="bio-paragraph">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
						<div class="oval-spacer oval-spacer-bottom" aria-hidden="true"></div>
					</div>
				</div>
			</div>
            <div id="section-2" class="content-section">
				<div class="bio-content flex flex-col items-center w-full">
					<div class="oval-flow">
						<div class="oval-carve carve-left" aria-hidden="true"></div>
						<div class="oval-carve carve-right" aria-hidden="true"></div>
						<div class="oval-spacer oval-spacer-top" aria-hidden="true"></div>
						<div class="name-container">
							<div class="title-wrapper">
								<h1 class="name-title">
									<span class="animated-gradient">Career Path</span>
								</h1>
								<div class="title-underline"></div>
							</div>
						</div>
						<p class="bio-paragraph">Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
						<div class="oval-spacer oval-spacer-bottom" aria-hidden="true"></div>
					</div>
				</div>
			</div>
            <div id="section-3" class="content-section">
                {/* flex-col only: desktop unwraps .oval-flow into title + body siblings */}
                <div class="bio-content flex flex-col items-center w-full gap-8">
					<div class="oval-flow">
						<div class="oval-carve carve-left" aria-hidden="true"></div>
						<div class="oval-carve carve-right" aria-hidden="true"></div>
						<div class="oval-spacer oval-spacer-top" aria-hidden="true"></div>
						<div class="name-container">
							<div class="title-wrapper">
								<h1 class="name-title">
									<span class="animated-gradient">Farpoint</span>
								</h1>
								<div class="title-underline"></div>
							</div>
						</div>
						<p class="bio-paragraph">Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.</p>
						<div class="oval-spacer oval-spacer-bottom" aria-hidden="true"></div>
					</div>
                </div>
            </div>
            <div id="section-4" class="content-section">
                <div class="bio-content flex flex-col items-center w-full">
					<div class="oval-flow">
						<div class="oval-carve carve-left" aria-hidden="true"></div>
						<div class="oval-carve carve-right" aria-hidden="true"></div>
						<div class="oval-spacer oval-spacer-top" aria-hidden="true"></div>
						<div class="name-container">
							<div class="title-wrapper">
								<h1 class="name-title">
									<span class="animated-gradient">Wandering mind</span>
								</h1>
								<div class="title-underline"></div>
							</div>
						</div>
						<p class="bio-paragraph">Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos.</p>
						<div class="oval-spacer oval-spacer-bottom" aria-hidden="true"></div>
					</div>
                </div>
            </div>
            <div id="section-5" class="content-section">
                <div class="bio-content flex flex-col md:flex-row items-center w-full gap-4">
                    <div class="profile-image-container">
                        <Image src={profilePic} alt="Profile photo" class="profile-image" width={440} quality="max" format="avif" />
                    </div>
                    <div class="text-content text-center md:text-left">
                        <div class="name-container">
                            <div class="title-wrapper">
                                <h1 class="name-title">
                                    <span class="animated-gradient">Becoming</span>
                                </h1>
                                <div class="title-underline"></div>
                            </div>
                        </div>
                        <div class="w-full">
                            <p class="bio-paragraph">Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet…</p>
                        </div>
                    </div>
                </div>
            </div>
            <div id="section-6" class="content-section">
                <div class="bio-content flex flex-col items-center w-full">
					<div class="oval-flow">
						<div class="oval-carve carve-left" aria-hidden="true"></div>
						<div class="oval-carve carve-right" aria-hidden="true"></div>
						<div class="oval-spacer oval-spacer-top" aria-hidden="true"></div>
						<div class="name-container">
							<div class="title-wrapper">
								<h1 class="name-title">
									<span class="animated-gradient">What now?</span>
								</h1>
								<div class="title-underline"></div>
							</div>
						</div>
						<p class="bio-paragraph">Ut enim ad minima veniam, quis nostrum exercitationem ullam corporis suscipit laboriosam.</p>
						<div class="oval-spacer oval-spacer-bottom" aria-hidden="true"></div>
						<div class="social-links">
							<div class="social-group">
								<a href="https://www.youtube.com/" aria-label="YouTube" target="_blank" rel="noreferrer noopener">
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.7 3.5 12 3.5 12 3.5s-7.7 0-9.4.6A3 3 0 0 0 .5 6.2 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.7.6 9.4.6 9.4.6s7.7 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z"></path></svg>
								</a>
								<a href="https://www.instagram.com/" aria-label="Instagram" target="_blank" rel="noreferrer noopener">
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3.5A5.5 5.5 0 1 1 6.5 13 5.5 5.5 0 0 1 12 7.5zm0 2A3.5 3.5 0 1 0 15.5 13 3.5 3.5 0 0 0 12 9.5zM18 6.5a1 1 0 1 1-1 1 1 1 0 0 1 1-1z"></path></svg>
								</a>
								<a href="https://github.com/" aria-label="GitHub" target="_blank" rel="noreferrer noopener">
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.4.7-4.1-1.6-4.1-1.6-.6-1.5-1.5-1.9-1.5-1.9-1.2-.8.1-.8.1-.8 1.3.1 2 .1 2 .1 1.2 2 3 1.4 3.7 1.1.1-.9.5-1.4.9-1.7-2.7-.3-5.5-1.4-5.5-6.1 0-1.4.5-2.5 1.3-3.4-.1-.3-.6-1.7.1-3.6 0 0 1.1-.4 3.5 1.3a12.1 12.1 0 0 1 6.3 0c2.4-1.7 3.5-1.3 3.5-1.3.7 1.9.2 3.3.1 3.6.8.9 1.3 2 1.3 3.4 0 4.7-2.8 5.8-5.5 6.1.5.4 1 1.2 1 2.5v3.7c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"></path></svg>
								</a>
							</div>
						</div>
					</div>
                </div>
            </div>
		</div>
	</div>

<script>
    import {
        lensNormDist,
        lensOpacity,
        nearestSectionIndex,
        snapCentersInScroller,
    } from '../lib/endosome-lens-scroll';

    // CONTINUOUS SCROLL-LINKED LENS ENGINE
    // Focus driven by measured .snap-section positions (not index * clientHeight).
    // Must stay inside <Layout>: sibling scripts after </Layout> emit after </html>.
    // Cache-bust marker 2026-07-30-win-scale-092: Windows bio text scale 0.85→0.92.

    const TOTAL_SECTIONS = 6;
    let sections: HTMLElement[] = [];
    let snapEls: HTMLElement[] = [];
    let bubbleEl: HTMLElement | null = null;
    let scrollerEl: HTMLElement | null = null;
    let rafId: number | null = null;

    const mediaQueryWarning = window.matchMedia('(prefers-reduced-motion: reduce)');
    let isReducedMotion = mediaQueryWarning.matches;
    let isMobileMode = false;

    /**
     * 1) Size carves to in-flow copy only (never taller — that lofted the text
     *    inside a flex/abs-centered box).
     * 2) Nudge so title→paragraph center matches the bubble center. The mobile
     *    sketch tracks that same .wave-bubble-container rect (content_pos), so
     *    this is the charcoal stroke center — not a divergent viewport mid.
     */
    function syncOvalCarveHeights() {
        const narrowMobile =
            window.matchMedia('(max-width: 900px)').matches &&
            document.body.classList.contains('is-mobile');
        const bubble = document.querySelector('.wave-bubble-container');

        document.querySelectorAll<HTMLElement>('.oval-flow').forEach((flow) => {
            const carves = Array.from(flow.querySelectorAll<HTMLElement>('.oval-carve'));
            flow.style.setProperty('--oval-nudge-y', '0px');

            if (!narrowMobile || !carves.length) {
                carves.forEach((c) => { c.style.height = ''; });
                flow.style.height = '';
                return;
            }

            const topEl = flow.querySelector('.oval-spacer-top') || flow.querySelector('.name-container');
            const bottomEl = flow.querySelector('.oval-spacer-bottom') || flow.querySelector('.bio-paragraph');
            const nameEl = flow.querySelector('.name-container');
            const paraEl = flow.querySelector('.bio-paragraph');
            const hasSocial = !!flow.querySelector('.social-links');
            if (!topEl || !bottomEl || !nameEl || !paraEl) return;

            const measureInFlow = () => {
                const top = topEl.getBoundingClientRect().top;
                const bottom = bottomEl.getBoundingClientRect().bottom;
                return Math.max(8 * 16, Math.ceil(bottom - top + 2));
            };

            flow.style.height = '';
            carves.forEach((c) => { c.style.height = '0px'; });
            void flow.offsetHeight;
            let h = Math.ceil(measureInFlow() * 1.2);
            for (let i = 0; i < 5; i++) {
                carves.forEach((c) => { c.style.height = `${h}px`; });
                void flow.offsetHeight;
                h = measureInFlow();
            }
            carves.forEach((c) => { c.style.height = `${h}px`; });
            flow.style.setProperty('--oval-carve-h', `${h}px`);
            if (!hasSocial) flow.style.height = `${h}px`;

            if (bubble) {
                const b = bubble.getBoundingClientRect();
                const targetCy = b.top + b.height / 2;
                const textCy =
                    (nameEl.getBoundingClientRect().top + paraEl.getBoundingClientRect().bottom) / 2;
                const nudge = Math.round(targetCy - textCy);
                flow.style.setProperty('--oval-nudge-y', `${nudge}px`);
            }
        });
    }

    function getScrollY(): number {
        if (isMobileMode && scrollerEl) return scrollerEl.scrollTop;
        return window.scrollY;
    }

    function getViewportH(): number {
        if (isMobileMode && scrollerEl) return scrollerEl.clientHeight || window.innerHeight;
        return window.innerHeight;
    }

    /** Measured snap tops — fixes Chrome iOS clientHeight vs 100dvh drift. */
    function getSnapCenters(viewportH: number): number[] {
        if (isMobileMode) {
            return snapCentersInScroller(snapEls, viewportH, TOTAL_SECTIONS);
        }
        // Desktop: document Y of each snap top
        return snapEls.length
            ? snapEls.map((el) => el.getBoundingClientRect().top + window.scrollY)
            : Array.from({ length: TOTAL_SECTIONS }, (_, i) => i * viewportH);
    }

    function initLens() {
        bubbleEl = document.querySelector<HTMLElement>('.wave-bubble-container');
        scrollerEl = document.querySelector<HTMLElement>('.content-wrapper');
        sections = Array.from(document.querySelectorAll<HTMLElement>('.content-section'));
        snapEls = Array.from(document.querySelectorAll<HTMLElement>('.scroll-proxy .snap-section'));

        const updateMode = () => {
            const nextMobile = document.body.classList.contains('is-mobile');
            if (isMobileMode && !nextMobile) {
                // Leaving mobile: clear any depth transforms once (not every RAF).
                sections.forEach((s) => {
                    s.style.transform = '';
                });
            }
            isMobileMode = nextMobile;
            syncOvalCarveHeights();
        };
        updateMode();
        window.addEventListener('resize', updateMode);
        window.visualViewport?.addEventListener('resize', updateMode);
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(() => syncOvalCarveHeights());
        }

        if (isMobileMode && scrollerEl) {
            scrollerEl.focus({ preventScroll: true });
        }

        if (bubbleEl && !bubbleEl.getAttribute('data-active')) {
            bubbleEl.setAttribute('data-active', '1');
        }

        mediaQueryWarning.addEventListener('change', (e) => {
            isReducedMotion = e.matches;
        });

        if (rafId !== null) cancelAnimationFrame(rafId);
        tick();
        requestAnimationFrame(() => syncOvalCarveHeights());
    }

    /** Avoid rewriting the same inline style every RAF — thrashing visibility /
     * pointer-events / transform stalls Chromium document mouse-wheel. */
    function setStyleProp(el: HTMLElement, prop: keyof CSSStyleDeclaration & string, value: string) {
        if (el.style[prop] !== value) {
            (el.style as unknown as Record<string, string>)[prop] = value;
        }
    }

    function tick() {
        rafId = requestAnimationFrame(tick);
        if (!scrollerEl) return;

        const scrollY = getScrollY();
        const viewportH = getViewportH();
        const centers = getSnapCenters(viewportH);

        if (isReducedMotion) {
            handleReducedMotion(scrollY, centers);
            return;
        }

        // Vignette from progress between neighboring snaps
        const nearest = nearestSectionIndex(scrollY, centers);
        const c0 = centers[nearest] ?? 0;
        const c1 = centers[nearest + 1] ?? c0 + viewportH;
        const span = Math.max(1, c1 - c0);
        const decimalPart = Math.min(1, Math.max(0, (scrollY - c0) / span));
        const vignetteOpacity = Math.sin(decimalPart * Math.PI).toFixed(2);
        if (bubbleEl) {
            if (bubbleEl.style.getPropertyValue('--vignette-opacity') !== vignetteOpacity) {
                bubbleEl.style.setProperty('--vignette-opacity', vignetteOpacity);
            }
            if (!bubbleEl.hasAttribute('data-lens-ready')) {
                bubbleEl.setAttribute('data-lens-ready', '1');
            }
        }

        sections.forEach((section, index) => {
            const centerY = centers[index] ?? index * viewportH;
            const prevCenter = centers[index - 1] ?? centerY - viewportH;
            const nextCenter = centers[index + 1] ?? centerY + viewportH;
            const normDist = lensNormDist(scrollY, centerY, prevCenter, nextCenter);

            if (Math.abs(normDist) > 1.15) {
                setStyleProp(section, 'opacity', '0');
                setStyleProp(section, 'filter', 'none');
                // Desktop: never toggle visibility/pointer-events in RAF — threshold
                // flicker at section boundaries stalls Chromium document mouse-wheel.
                // Mobile uses a locked scroller; hard-hide there is fine.
                if (isMobileMode) {
                    setStyleProp(section, 'visibility', 'hidden');
                    setStyleProp(section, 'pointerEvents', 'none');
                }
                return;
            }

            const opacity = lensOpacity(normDist);
            const blurVal = Math.abs(normDist) * 20;
            let scale = 1;
            let translateZ = 0;
            let translateY = 0;

            if (normDist > 0) {
                scale = 1 - normDist * 0.15;
                translateZ = -(normDist * 100);
                translateY = -(normDist * 20);
            } else {
                scale = 1 + Math.abs(normDist) * 0.05;
                translateZ = Math.abs(normDist) * 50;
                translateY = -(normDist * 20);
            }

            // Hard-hide nearly invisible sections so they cannot stack/overlap
            const show = opacity > 0.04;
            setStyleProp(section, 'opacity', opacity.toFixed(3));
            setStyleProp(section, 'filter', show ? `blur(${blurVal.toFixed(1)}px)` : 'none');
            // Desktop: never write visibility / pointer-events / transform in RAF
            // (document mouse-wheel stalls). Mobile OK.
            if (isMobileMode) {
                setStyleProp(section, 'visibility', show ? 'visible' : 'hidden');
                setStyleProp(section, 'pointerEvents', opacity > 0.55 ? 'auto' : 'none');
                setStyleProp(
                    section,
                    'transform',
                    `translate3d(0, ${translateY.toFixed(1)}px, ${translateZ.toFixed(1)}px) scale(${scale.toFixed(3)})`,
                );
            }
        });

        const activeIdx = nearestSectionIndex(scrollY, centers) + 1;
        if (bubbleEl && bubbleEl.getAttribute('data-active') !== String(activeIdx)) {
            bubbleEl.setAttribute('data-active', String(activeIdx));
        }
    }

    function handleReducedMotion(scrollY: number, centers: number[]) {
        const active = nearestSectionIndex(scrollY, centers);
        sections.forEach((section, index) => {
            const on = index === active;
            section.classList.toggle('active-simple', on);
            section.style.opacity = on ? '1' : '0';
            section.style.visibility = on ? 'visible' : 'hidden';
            section.style.pointerEvents = on ? 'auto' : 'none';
            section.style.transform = '';
            section.style.filter = '';
        });
        if (bubbleEl) bubbleEl.setAttribute('data-lens-ready', '1');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLens);
    } else {
        initLens();
    }
    document.addEventListener('astro:page-load', initLens);

    document.addEventListener('astro:before-swap', () => {
        if (rafId !== null) cancelAnimationFrame(rafId);
    });
</script>
</Layout>

<style>
    /* HYBRID SCROLL STRATEGY: 
       Desktop (Unchanged) -> Uses standard html/body scrolling.
       Mobile (Stabilized) -> Uses locked root + inner scroller to stop address bar jumps.
       SCOPED TO HOME PAGE ONLY - prevents affecting other pages like bio
    */
    /* Scope all styles to home page only to prevent affecting other pages */
    /* Scope all styles to home page only to prevent affecting other pages */
    /* MOBILE SCROLL STRATEGY: ONLY for actual mobile devices */
    @media (max-width: 900px) {
        body.page-home.is-mobile {
            overflow: hidden !important;
            height: 100% !important;
            width: 100%;
            margin: 0;
            padding: 0;
            position: relative;
        }

        /* DESKTOP NARROW: body must NOT be overflow-y:auto. Layout sets
           overflow-x:hidden on body → CSS computes overflow-y to auto, and a
           non-overflowing body scrollport eats discrete mouse-wheel (keyboard/
           trackpad still scroll the documentElement). Keep scroll on html only. */
        body.page-home.is-desktop {
            overflow: visible !important;
            height: auto !important;
            scroll-snap-type: none;
        }
    }

    /* Desktop home: html is the only scrollport. No CSS scroll-snap (Chromium
       traps mouse-wheel notches on 100vh snap targets). Lens still measures
       .snap-section tops for section focus. */
    html:has(body.page-home.is-desktop) {
        overflow-x: hidden;
        overflow-y: auto;
        scroll-snap-type: none;
        scroll-behavior: auto;
    }
    body.page-home.is-desktop {
        /* Both axes visible so body is not a scroll container (see CSS overflow
           pairing: overflow-x ≠ visible forces overflow-y to compute as auto). */
        overflow: visible !important;
    }

	/* Wrapper for entire content area - Scroller on mobile, layout-only on desktop */
    .content-wrapper {
        width: 100%;
        position: relative;
    }

    @media (max-width: 900px) {
        /* MOBILE DEVICE: Inner container with continuous (proximity) scroll.
           Not mandatory snap — flick freely; settles gently near section stops. */
        body.page-home.is-mobile .content-wrapper {
            height: 100dvh;
            overflow-y: auto;
            overflow-x: hidden;
            scroll-snap-type: y proximity;
            /* Enable momentum scrolling on iOS */
            -webkit-overflow-scrolling: touch;
            /* Allow vertical scrolling only */
            touch-action: pan-y;
            /* Prevent pull-to-refresh on this inner scroller */
            overscroll-behavior-y: contain;
            outline: none;

            /* HIDE SCROLLBARS to maintain layout design */
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        body.page-home.is-mobile .content-wrapper::-webkit-scrollbar {
            display: none;
        }

        /* DESKTOP NARROW: Standard flow, visible scrollbars */
        body.page-home.is-desktop .content-wrapper {
            height: 600vh; /* FORCE Height to generate scrollbar */
            min-height: 100vh;
            overflow: visible;
            /* Ensure scrollbar visibility */
            -ms-overflow-style: auto;
            scrollbar-width: auto;
        }
    }

    @media (min-width: 901px) {
        body.page-home .content-wrapper {
            /* Total height for 6 sections on desktop root scroll */
            height: 600vh;
        }
    }
    
    .scroll-proxy {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        pointer-events: none;
        display: flex;
        flex-direction: column;
    }

    @media (max-width: 900px) {
        /* Mobile Proxy for Scroll triggering */
        body.is-mobile .scroll-proxy {
            height: 600dvh; /* Driven by d-units on mobile */
        }
        /* Desktop Narrow Proxy: MUST be visible to force page height */
        body.is-desktop .scroll-proxy {
            height: 100%; /* Inherits 600vh from parent wrapper */
            display: flex; /* Restore display */
        }
    }

    @media (min-width: 901px) {
        .scroll-proxy {
            height: 100%; /* Total 600vh from parent wrapper */
        }
    }
    
    .snap-section {
        height: 100vh;
        width: 100%;
        /* Snap align only on mobile scroller — see body.is-mobile below */
    }

    @media (max-width: 900px) {
        body.is-mobile .snap-section {
            /* Continuous scroll: dvh stops + soft settle (no hard mandatory locks) */
            height: 100dvh;
            scroll-snap-align: start;
            scroll-snap-stop: normal;
        }
        
        /* Desktop Narrow: spacers for scroll height; no CSS snap (mouse-wheel trap) */
        body.is-desktop .snap-section {
           height: auto;
           min-height: 100vh; /* Ensure full screen at least */
           scroll-snap-align: none;
           padding: 4rem 0; /* Add padding for breathability */
        }
    }

    @media (min-width: 901px) {
